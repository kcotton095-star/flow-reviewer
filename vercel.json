{
  "version": 2,
  "builds": [
    { "src": "api/*.js",    "use": "@vercel/node" },
    { "src": "index.html",  "use": "@vercel/static" },
    { "src": "review.html", "use": "@vercel/static" },
    { "src": "favicon.svg", "use": "@vercel/static" },
    { "src": "data/*.json", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/onboarding-trigger", "dest": "/api/onboarding-trigger.js" },
    { "src": "/api/stripe-webhook",     "dest": "/api/stripe-webhook.js" },
    { "src": "/api/review-config",      "dest": "/api/review-config.js" },
    { "src": "/api/review-submit",      "dest": "/api/review-submit.js" },
    { "src": "/api/dashboard-data",     "dest": "/api/dashboard-data.js" },
    { "src": "/review/(.*)",            "dest": "/review.html" },
    { "src": "/data/(.*)",              "dest": "/data/$1" },
    { "src": "/(.*)",                   "dest": "/index.html" }
  ]
}
